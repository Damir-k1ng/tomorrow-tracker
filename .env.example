# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL connection string.
# Local example below; Railway injects DATABASE_URL automatically.
DATABASE_URL=postgres://tomorrow:tomorrow@localhost:5432/tomorrow?sslmode=disable

# Timezone used for all weekly/daily/streak calculations
TIMEZONE=Asia/Almaty

# Weekly study target in hours
WEEKLY_TARGET_HOURS=30

# Log level: debug | info | warn | error
LOG_LEVEL=info

# HTTP port for the health + API endpoints (Railway sets PORT automatically)
PORT=8080

# Telegram ID auto-promoted to the admin role (set 0 to disable)
ADMIN_TELEGRAM_ID=165146312

# Comma-separated CORS allow-list for the future Mini App frontend ("*" = any)
CORS_ALLOWED_ORIGINS=*

# Deployment environment: "production" enables fail-fast safety checks
# (e.g. rejecting the placeholder frontend). Railway production must set this.
APP_ENV=development
